---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  /** Lay the header over a full-bleed hero (home page only). */
  overlayHeader?: boolean;
}

const { overlayHeader = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <BaseHead {...head} />
    <!-- Halloween 2026 theme. Writes nothing on or after 2026-11-01T00:00:00-06:00.
         Remove this block and public/halloween/ on 2026-11-02. -->
    <!-- halloween:start -->
    <!-- halloween:end -->
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <SiteHeader overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/sw-register.ts"></script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--accent);
    color: var(--bg);
    padding: 0.5rem 1rem;
    border-radius: 0 0 2px 0;
    font-family: var(--font-mono);
    text-decoration: none;
    z-index: 10;
  }

  .skip:focus {
    left: 0;
  }
</style>
