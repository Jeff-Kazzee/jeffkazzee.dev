---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  /** Lay the header over a full-bleed hero (home page only). */
  overlayHeader?: boolean;
}

const { overlayHeader = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <BaseHead {...head} />
    <!-- Halloween 2026 theme. Writes nothing on or after 2026-11-01T00:00:00-06:00.
         Remove this block and public/halloween/ on 2026-11-02. -->
    <!-- halloween:start -->
    <script is:inline>(function () {
const HALLOWEEN_CUTOFF_ISO = '2026-11-01T00:00:00-06:00';
const HALLOWEEN_CUTOFF_MS = 1793512800000;
const SESSION_KEY = 'lac_halloween_override';

function storageCall(storage, method, value) {
  try {
    return storage ? storage[method](SESSION_KEY, value) : null;
  } catch (e) {
    return null;
  }
}

function shouldActivateHalloween({ search = '', nowMs, storage } = {}) {
  const query = new URLSearchParams(search).get('halloween');
  if (query === '1' || query === '0') {
    storageCall(storage, 'setItem', query);
    return query === '1';
  }
  if (query === 'auto') storageCall(storage, 'removeItem');
  const stored = storageCall(storage, 'getItem');
  if (stored === '1' || stored === '0') return stored === '1';
  return nowMs < HALLOWEEN_CUTOFF_MS;
}

function isQuietRoute(pathname = '') {
  return /^\/(game|dev)(\/|$)/.test(pathname);
}
var s = null;
try { s = window.sessionStorage; } catch (e) {}
if (!shouldActivateHalloween({ search: location.search, nowMs: Date.now(), storage: s })) return;
var d = document.documentElement;
d.setAttribute('data-lac-host', 'jeffkazzee');
if (!isQuietRoute(location.pathname)) d.setAttribute('data-halloween', 'true');
document.write('<link rel="stylesheet" href="/halloween/halloween.css"><script src="/halloween/halloween-init.js"><\/script>');
})();</script>
    <!-- halloween:end -->
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <SiteHeader overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/sw-register.ts"></script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--accent);
    color: var(--bg);
    padding: 0.5rem 1rem;
    border-radius: 0 0 2px 0;
    font-family: var(--font-mono);
    text-decoration: none;
    z-index: 10;
  }

  .skip:focus {
    left: 0;
  }
</style>
