---
interface Props {
  href: string;
  variant?: 'primary' | 'default';
}

const { href, variant = 'default' } = Astro.props;
const external = href.startsWith('http');
---

<a class:list={['btn lift', variant]} href={href} rel={external ? 'noopener' : undefined}>
  [ <slot /> ]
</a>

<style>
  .btn {
    display: inline-block;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    padding: 0.6rem 1rem;
  }

  .btn:hover {
    background: var(--surface);
    color: var(--ink);
  }

  .btn.primary {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }

  .btn.primary:hover {
    background: var(--accent);
    color: #000;
    box-shadow: 10px 10px 0 0 var(--ink);
  }
</style>
