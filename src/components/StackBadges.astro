---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <ul class="badges" role="list">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
)}

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .badges li {
    background: var(--paper-deep);
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 500;
    border-radius: 999px;
    padding: 0.18rem 0.7rem;
  }
</style>
