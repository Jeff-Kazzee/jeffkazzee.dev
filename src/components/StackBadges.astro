---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <ul class="badges" role="list">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
)}

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .badges li {
    border: 2px solid var(--ink-dim);
    color: var(--ink-dim);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.5rem;
  }
</style>
