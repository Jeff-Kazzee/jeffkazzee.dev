---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  /** Override for mirrored content (e.g. Substack originals). */
  canonicalUrl?: string;
  /** Keep the page out of search results. Also exclude it in astro.config.mjs. */
  noindex?: boolean;
}

const { title, description, ogImage = '/og-default.png', ogType = 'website', canonicalUrl, noindex = false } = Astro.props;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageAbs = new URL(ogImage, Astro.site).href;

/**
 * Path of this page's Markdown twin. Same rule the middleware applies when a
 * request arrives with `Accept: text/markdown`.
 */
const { pathname } = Astro.url;
const markdownPath = pathname === '/' ? '/index.md' : `${pathname.replace(/\/+$/, '')}.md`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#15171f" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&family=Hanken+Grotesk:ital,wght@0,400..700;1,400..700&display=swap"
/>

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:site_name" content="jeffkazzee.dev" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />

<link rel="alternate" type="application/rss+xml" title="jeffkazzee.dev" href={new URL('rss.xml', Astro.site).href} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Machine-readable entry points. See /for-agents/ for the full surface. -->
<link rel="alternate" type="text/markdown" href={markdownPath} title="This page as Markdown" />
<link rel="api-catalog" href="/.well-known/api-catalog" />
<link rel="service-desc" type="application/json" href="/.well-known/mcp/server-card.json" />
<link rel="describedby" type="application/json" href="/.well-known/agent-skills/index.json" />
<link rel="ard" href="/.well-known/ard.json" />
<link rel="ai-catalog" href="/.well-known/ai-catalog.json" />

<script src="../scripts/webmcp.ts"></script>

<ClientRouter />
