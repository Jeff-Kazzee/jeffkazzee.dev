---
/**
 * A project's recorded status, the same everywhere on the site: a small dot
 * and the status word in mono. The word is always printed, so color is
 * never the only signal.
 *
 *   shipped                     glacier blue
 *   wip, alpha, prototype       gold (kept apart from the link amber)
 *   demo                        gray
 *   deprecated                  gray, hollow dot
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  status: CollectionEntry<'projects'>['data']['status'];
  /** Extra words after the status, such as a date. */
  suffix?: string;
}

const { status, suffix } = Astro.props;
const tone =
  status === 'shipped'
    ? 'shipped'
    : status === 'deprecated'
      ? 'retired'
      : status === 'demo'
        ? 'quiet'
        : 'active';
---

<span class="status" data-tone={tone}>
  <span class="dot" aria-hidden="true"></span>{status}{suffix && <span class="suffix"> · {suffix}</span>}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--neutral);
  }

  .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }

  [data-tone='shipped'] {
    color: var(--glacier);
  }

  [data-tone='active'] {
    color: var(--progress);
  }

  [data-tone='retired'] .dot {
    background: transparent;
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .suffix {
    color: var(--ink-faint);
  }
</style>
