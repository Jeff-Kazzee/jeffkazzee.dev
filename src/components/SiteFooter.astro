---
const links = [
  { href: 'https://github.com/Jeff-Kazzee', label: 'GitHub' },
  { href: 'https://x.com/jeffkazzee', label: 'X' },
  { href: 'https://jeffkazzee.substack.com', label: 'Substack' },
  { href: 'https://jeffkazzee.zo.space', label: 'zo.space' },
  { href: 'mailto:jeffkazzee@gmail.com', label: 'Email' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer>
  <div class="wrap inner">
    <div>
      <p class="line"><a href="https://jeffkazzee.dev">jeffkazzee.dev</a> is home. My Zo Computer lives at <a href="https://jeffkazzee.zo.space" rel="me noopener">jeffkazzee.zo.space</a>.</p>
      <nav aria-label="Footer">
        {links.map((l) => (
          <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>{l.label}</a>
        ))}
      </nav>
    </div>
    <div class="credits">
      <p>© {new Date().getFullYear()} Jeff Kazzee</p>
      <p class="colophon">Built with Astro and AI agents. Hand-rolled CSS, no trackers.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    margin-top: clamp(3rem, 7vh, 4.5rem);
    background: var(--bg);
  }

  .inner {
    padding-block: calc(var(--space) * 4);
    display: grid;
    gap: calc(var(--space) * 3);
  }

  .line {
    font-size: 0.88rem;
    color: var(--ink-faint);
    margin-bottom: 0.9rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  nav a {
    font-size: 0.9rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
  }

  .colophon {
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .credits {
    display: grid;
    gap: 0.3rem;
    color: var(--ink-faint);
    font-size: 0.82rem;
  }

  @media (min-width: 760px) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .credits {
      justify-items: end;
      text-align: right;
    }
  }
</style>
