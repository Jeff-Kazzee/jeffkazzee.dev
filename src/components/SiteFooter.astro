---
const links = [
  { href: 'https://github.com/Jeff-Kazzee', label: 'GitHub' },
  { href: 'https://x.com/jeffkazzee', label: 'X' },
  { href: 'https://jeffkazzee.substack.com', label: 'Substack' },
  { href: 'mailto:jeffkazzee@gmail.com', label: 'Email' },
  { href: '/rss.xml', label: 'RSS' },
  { href: '/llms.txt', label: 'llms.txt' },
  { href: '/for-agents/', label: 'For agents' },
];
---

<footer>
  <div class="wrap inner">
    <p class="line">Built on my own terms. Still learning, still here.</p>
    <nav aria-label="Footer">
      {links.map((l) => (
        <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>{l.label}</a>
      ))}
    </nav>
    <p class="colophon">
      Built with Astro and AI agents. Hand-rolled CSS, no trackers. Every page is also
      <a href="/for-agents/">readable as Markdown</a>.
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: clamp(4rem, 12vh, 7rem);
  }

  .inner {
    padding-block: 0 calc(var(--space) * 6);
    display: grid;
    gap: calc(var(--space) * 2);
  }

  /* The rule sits inside the content column, like every other divider. */
  .inner::before {
    content: '';
    border-top: 1px solid var(--line);
    margin-bottom: calc(var(--space) * 4);
  }

  .line {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }

  nav a {
    font-size: 0.95rem;
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: 0.75rem;
  }

  nav a:hover {
    color: var(--accent-bright);
  }

  .colophon {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-faint);
  }
</style>
