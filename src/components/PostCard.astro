---
import { renderWritingCard } from '../lib/writing-list.mjs';
import type { WritingItem } from '../lib/writing';
interface Props { post: WritingItem; index?: number; }
const { post, index = 0 } = Astro.props;
---
<Fragment set:html={renderWritingCard(post, index)} />

<style is:global>
  .writing-post {
    display: grid;
    gap: calc(var(--space) * 0.75);
    padding-block: calc(var(--space) * 3.5);
    border-top: 1px solid var(--line);
  }

  .writing-post .date {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  .writing-post h2 {
    font-size: 1.35rem;
    font-weight: 540;
  }

  .writing-post h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .writing-post h2 a:hover {
    color: var(--accent);
  }

  .writing-post .desc {
    color: var(--ink-soft);
    font-size: 0.97rem;
    max-width: 58ch;
  }
</style>
