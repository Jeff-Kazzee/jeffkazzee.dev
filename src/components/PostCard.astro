---
import FormattedDate from './FormattedDate.astro';
import type { WritingItem } from '../lib/writing';

interface Props {
  post: WritingItem;
  index?: number;
}

const { post, index = 0 } = Astro.props;
---

<article class="post reveal" style={`--i: ${index}`}>
  <p class="date">
    <FormattedDate date={post.pubDate} />{post.external && <span> · On Substack</span>}
  </p>
  <h2><a href={post.href} rel={post.external ? 'noopener' : undefined}>{post.title}</a></h2>
  <p class="desc">{post.description}</p>
</article>

<style>
  .post {
    display: grid;
    gap: calc(var(--space) * 0.75);
    padding-block: calc(var(--space) * 3.5);
    border-top: 1px solid var(--line);
  }

  .date {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 540;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  .desc {
    color: var(--ink-soft);
    font-size: 0.97rem;
    max-width: 58ch;
  }
</style>
