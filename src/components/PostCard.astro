---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
}

const { post, index = 0 } = Astro.props;
---

<article class="post reveal" style={`--i: ${index}`}>
  <p class="date"><FormattedDate date={post.data.pubDate} /></p>
  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
  <p class="desc">{post.data.description}</p>
</article>

<style>
  .post {
    display: grid;
    gap: calc(var(--space) * 0.75);
    padding-block: calc(var(--space) * 3.5);
    border-top: 1px solid var(--line);
  }

  .date {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  h3 {
    font-size: 1.35rem;
    font-weight: 540;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .desc {
    color: var(--ink-soft);
    font-size: 0.97rem;
    max-width: 58ch;
  }
</style>
