---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Status from './Status.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Stagger index for scroll reveal. */
  index?: number;
  /** Load the screenshot at once: set for cards on the first screen. */
  priority?: boolean;
}

/*
 * Same card as the home page: a framed screenshot, title, description, then
 * status. No panel around it, so the two pages read as one site.
 */
const { project, index = 0, priority = false } = Astro.props;
const { title, description, status, screenshots, metric } = project.data;
const thumb = screenshots[0];
---

<article class="card reveal" style={`--i: ${index}`}>
  <span class="frame">
    {thumb ? (
      <Image
        class="shot"
        data-fit={thumb.fit}
        src={thumb.src}
        alt={thumb.alt}
        widths={[360, 480, 720, 960]}
        sizes="(min-width: 1120px) 330px, (min-width: 720px) calc(33vw - 3rem), calc(100vw - 2rem)"
        format="webp"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    ) : metric ? (
      <span class="metric" aria-hidden="true">
        <span class="metric-value">{metric.value}</span>
        <span class="metric-label">{metric.label}</span>
      </span>
    ) : null}
  </span>
  <h2><a href={`/projects/${project.id}/`}>{title}</a></h2>
  <p class="desc">{description}</p>
  <Status status={status} />
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: calc(var(--space) * 1.25);
    align-content: start;
    min-width: 0;
  }

  .frame {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    margin-bottom: calc(var(--space) * 0.75);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .frame :global(.shot) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Left edge first: page screenshots read from the left, so a crop
       should never cut the start of a word. */
    object-position: left top;
    transition: filter 0.3s var(--ease-out);
  }

  .frame :global(.shot[data-fit='contain']) {
    object-fit: contain;
    object-position: center;
  }

  .card:hover .frame :global(.shot) {
    filter: brightness(1.08);
  }

  h2 {
    font-size: 1.15rem;
    line-height: 1.3;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out);
  }

  /* Whole card is the click target. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover h2 a {
    color: var(--accent-bright);
  }

  .desc {
    font-size: 0.975rem;
    color: var(--ink-muted);
  }

  /* Stands in for a screenshot, same slot and proportions. */
  .metric {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    background: var(--bg-raised);
  }

  .metric-value {
    font-size: clamp(2.5rem, 6vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
</style>
