---
interface Props {
  /** Sit transparently over a full-bleed hero instead of on its own band. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const items = [
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Writing' },
  { href: '/for-agents/', label: 'For agents' },
  { href: '/work-with-me/', label: 'Work with me', cta: true },
];
const isActive = (href: string) => path.startsWith(href);
---

<header class:list={{ overlay }} style="view-transition-name: site-header">
  <div class="wrap bar">
    <a class="mark" href="/">Jeff Kazzee</a>
    <nav aria-label="Main">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href), cta: item.cta }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    position: relative;
    z-index: 2;
  }

  header.overlay {
    position: absolute;
    inset: 0 0 auto 0;
    background: transparent;
    border-bottom: none;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: calc(var(--space) * 2);
    flex-wrap: wrap;
  }

  .mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.5rem;
  }

  .mark:hover {
    color: var(--accent-bright);
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1rem, 2.4vw, 1.75rem);
  }

  .nav-link {
    font-size: 0.95rem;
    color: var(--ink-soft);
    text-decoration: none;
    /* 44px touch target */
    padding-block: 0.8rem;
  }

  .nav-link.cta {
    color: var(--accent);
  }

  .nav-link:hover {
    color: var(--accent-bright);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    nav {
      gap: 0 1rem;
    }

    .nav-link {
      font-size: 0.9rem;
    }
  }

  .nav-link.active {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
</style>
