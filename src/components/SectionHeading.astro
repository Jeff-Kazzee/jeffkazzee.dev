---
interface Props {
  title: string;
  level?: 'h1' | 'h2' | 'h3';
  id?: string;
  /** Short secondary line set beside/below the heading. */
  note?: string;
}

const { title, level = 'h2', id, note } = Astro.props;
const Tag = level;
---

<div class="heading">
  <Tag id={id}>{title}</Tag>
  {note && <p class="note">{note}</p>}
</div>

<style>
  /* Heading with its note stacked underneath, on the same left edge. */
  .heading {
    margin-block: clamp(3.5rem, 9vh, 5.5rem) calc(var(--space) * 4);
    display: grid;
    gap: calc(var(--space) * 1);
  }

  .heading:has(h1) {
    margin-block-start: clamp(2.5rem, 7vh, 4rem);
  }

  .note {
    font-size: 1rem;
    color: var(--ink-muted);
    max-width: 60ch;
  }
</style>
