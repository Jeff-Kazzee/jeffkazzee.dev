---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  planet: ImageMetadata;
  index?: number;
}

const { project, planet, index = 0 } = Astro.props;
const statusLabel = project.data.status.replaceAll('-', ' ');
---

<article class="project-row reveal" style={`--i: ${index}`}>
  <a class="planet-link" href={`/projects/${project.id}/`} aria-hidden="true" tabindex="-1">
    <Image
      class="planet"
      src={planet}
      alt=""
      width={132}
      height={132}
      widths={[96, 132, 192, 264]}
      sizes="(max-width: 640px) 76px, 104px"
      quality={74}
    />
  </a>
  <div class="project-copy">
    <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
    <p>{project.data.description}</p>
  </div>
  <p class:list={['status', `status-${project.data.status}`]}>
    {statusLabel}
    {project.data.status !== 'coming-soon' && <span aria-hidden="true">→</span>}
  </p>
</article>

<style>
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: 5.75rem minmax(0, 1fr) auto;
    gap: clamp(1.25rem, 3vw, 2.4rem);
    align-items: center;
    min-height: 8.25rem;
    padding-block: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .planet-link {
    display: block;
    border-radius: 50%;
  }

  .planet-link::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .planet-link :global(.planet) {
    width: 5.75rem;
    height: 5.75rem;
    object-fit: cover;
    border-radius: 50%;
    filter: saturate(0.92) contrast(1.04);
    transition: filter var(--t-base) var(--ease-out), transform var(--t-base) var(--ease-out);
  }

  .project-row:hover .planet-link :global(.planet) {
    filter: saturate(1.08) contrast(1.06);
    transform: scale(1.035);
  }

  .project-copy {
    display: grid;
    gap: 0.45rem;
  }

  h3 {
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
  }

  h3 a {
    position: relative;
    z-index: 1;
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .project-copy p {
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .status {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 1.25rem;
    align-items: center;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 620;
    letter-spacing: 0.01em;
    text-transform: capitalize;
    white-space: nowrap;
  }

  .status-coming-soon {
    color: var(--amber);
  }

  .status-deprecated {
    color: var(--ink-faint);
  }

  @media (max-width: 640px) {
    .project-row {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      gap: 1rem;
      min-height: 7.8rem;
      padding-block: 1rem;
    }

    .planet-link :global(.planet) {
      width: 4.75rem;
      height: 4.75rem;
    }

    .status {
      grid-column: 2;
      margin-top: -0.25rem;
      font-size: 0.72rem;
    }
  }
</style>
