---
interface Props {
  command: string;
  level?: 'h1' | 'h2' | 'h3';
  id?: string;
}

const { command, level = 'h2', id } = Astro.props;
const Tag = level;
---

<Tag class="prompt glitch" data-text={`$ ${command}`} id={id}>
  <span class="sigil" aria-hidden="true">$</span> {command}
</Tag>

<style>
  .prompt {
    margin-block: calc(var(--space) * 6) calc(var(--space) * 3);
  }

  .sigil {
    color: var(--accent);
  }
</style>
