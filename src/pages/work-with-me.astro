---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LinkButton from '../components/LinkButton.astro';

// ============================================================
// Booking + payment links. Public URLs, safe to commit.
// The half hour is the only self-serve path: pay, then book a slot.
// Anything longer than 30 minutes or for a group is arranged by email.
// ============================================================
const BOOKING_URL = 'https://calendar.app.google/HnkQMCj9ykUGUhoi6';
const STRIPE_HALF_HOUR = 'https://buy.stripe.com/9B6dR92WvcoZ4Vw8BS08g09';
const EMAIL = 'jeffkazzee@gmail.com';

// Payment links to send after someone emails for a longer or group session:
//   One hour ($65):            https://buy.stripe.com/fZu4gzeFddt3fAa6tK08g0a
//   Three-session pack ($100): https://buy.stripe.com/7sYbJ168H74Few69FW08g08

const bookingEmail = (subject: string) =>
  `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(
    'What do you want to work on?\nHow many people?\nWhich days and times work for you?\n',
  )}`;

const projectEmail = `mailto:${EMAIL}?subject=${encodeURIComponent(
  'Project inquiry',
)}&body=${encodeURIComponent(
  'What do you want built?\nWho is it for?\nWhat should be true when it is done?\nIs there a deadline or budget I should know about?\n',
)}`;

const services = [
  {
    title: 'Sites that do a job',
    desc: 'A new site or a focused rebuild for a small business, creator, product, or event. Clear structure, strong copy, responsive pages, and the forms, booking, or payments the site actually needs.',
  },
  {
    title: 'Small apps and internal tools',
    desc: 'A useful first version of the dashboard, browser tool, content system, or workflow your team keeps trying to hold together with tabs and spreadsheets.',
  },
  {
    title: 'AI workflows and automations',
    desc: 'Turn a repeated process into a workflow with clear inputs, review steps, and a handoff your team can understand. No mystery box that only works while I am in the room.',
  },
];

const buildSteps = [
  {
    title: 'Tell me the outcome.',
    desc: 'Send the problem, who it is for, and what done should look like. A rough note is enough.',
  },
  {
    title: 'I make the scope small and clear.',
    desc: 'You get the deliverable, exclusions, checkpoints, price, and handoff in writing before the build starts.',
  },
  {
    title: 'We review working software.',
    desc: 'You see the real thing at useful checkpoints. At handoff, you get the source, setup notes, and a walkthrough.',
  },
];

const tracks = [
  {
    title: 'Learn to code with AI',
    desc: 'From zero, or close to it. Real tools, Cursor, Claude, and Zo Computer, on a real project instead of a toy exercise. You leave able to read code, change it, and ship it with an AI pair.',
  },
  {
    title: 'Use AI for real work',
    desc: 'Your actual job. Research, writing, data, docs, and automating the boring parts. Done faster, and understood well enough that you can trust the output instead of guessing at it.',
  },
  {
    title: 'Build something real',
    desc: 'Bring an idea. Leave with a working, shippable thing: a tool, a site, an automation. Step by step, screen-shared. You drive, I guide.',
  },
];

const pricing = [
  {
    name: 'Half hour',
    price: '$40',
    desc: 'One session, one screen, one problem. The fastest way to find out if this works for you.',
    cta: 'Pay and book',
    href: STRIPE_HALF_HOUR,
    selfServe: true,
  },
  {
    name: 'One hour',
    price: '$65',
    desc: 'Two thirty-minute blocks, back to back. Send a note first so we can line up the time.',
    cta: 'Email to book an hour',
    href: bookingEmail('Booking an hour session'),
    selfServe: false,
  },
  {
    name: 'Three-session pack',
    price: '$100',
    desc: 'Three half-hour sessions. The best value, because the second and third are usually where it clicks.',
    cta: 'Email to arrange',
    href: bookingEmail('Three-session pack'),
    selfServe: false,
  },
  {
    name: 'Groups and workshops',
    price: 'from $25 / person',
    desc: 'Small group of two to four at $35 a person per hour. Workshop of five to ten at $25 a person per hour. Tell me the group and the topic.',
    cta: 'Email about a group',
    href: bookingEmail('Group session or workshop'),
    selfServe: false,
  },
];

const shipped = [
  { name: 'Vivary', href: 'https://vivary.vercel.app/' },
  { name: 'Bellamente', href: 'https://the-little-ai-company.github.io/bellamente/' },
  { name: 'Journeyman', href: 'https://the-little-ai-company.github.io/journeyman/' },
  { name: 'The Kill List', href: 'https://kill-list-jeffkazzee.zocomputer.io/' },
  { name: 'Zo Computer 101', href: 'https://www.zocomputer101.wiki/' },
  { name: 'Zo Cookbook', href: 'https://www.zo-cookbook.space/' },
  { name: 'Ukrainian Trainer', href: 'https://ukrainian-trainer-jeffkazzee.zocomputer.io/' },
];

const faqs = [
  {
    q: 'Do I need experience?',
    a: 'No. Plenty of people start at zero. That is a normal place to start.',
  },
  {
    q: 'What do I need installed?',
    a: 'Nothing to begin. If we need a tool, we set it up together on the call.',
  },
  {
    q: 'Can my team book together?',
    a: 'Yes. Two to four is a small group, five to ten is a workshop, both at a lower rate per person.',
  },
  {
    q: 'Can I reschedule?',
    a: 'Yes. Give me at least 24 hours notice and we will find a new time.',
  },
  {
    q: 'Refunds?',
    a: 'If your first session is not useful, tell me and I refund it. That is the whole policy.',
  },
];
---

<BaseLayout
  title="Hire Jeff Kazzee to build a site, app, or AI workflow"
  description="Focused sites, small apps, AI workflows, and live build-with-me sessions for founders, creators, and small teams."
>
  <section class="hero wrap">
    <p class="now rise" style="--i: 0">
      <span class="dot" aria-hidden="true"></span>
      Done-for-you builds and live working sessions
    </p>
    <h1 class="rise" style="--i: 1">I build practical sites, apps, and AI workflows. Or I help you build them.</h1>
    <p class="lede rise" style="--i: 2">
      Bring me the process your business keeps doing by hand, the site that no longer fits, or the
      app you cannot quite get shipped. I can scope it, build it, and hand it over. If you want to
      learn the tools instead, we can work side by side.
    </p>
    <div class="cta rise" style="--i: 3">
      <LinkButton href={projectEmail} variant="primary">Tell me what you need built</LinkButton>
      <LinkButton href="#coaching">Book a working session</LinkButton>
    </div>
  </section>

  <section class="wrap" id="services">
    <SectionHeading
      title="Hire me to build it"
      note="Small, useful software with a clear handoff."
    />
    <div class="grid services-grid">
      {services.map((service, i) => (
        <article class="surface card reveal" style={`--i: ${i}`}>
          <h3>{service.title}</h3>
          <p>{service.desc}</p>
        </article>
      ))}
    </div>
    <div class="service-fit surface">
      <div>
        <h3>Good fit</h3>
        <p>A focused build with one clear owner, a real user, and a finish line we can name.</p>
      </div>
      <div>
        <h3>Probably not a fit</h3>
        <p>An enterprise rewrite, an open-ended staff-augmentation role, or high-stakes automation with no human review.</p>
      </div>
    </div>
  </section>

  <section class="wrap">
    <SectionHeading title="How a build works" />
    <ol class="steps flow build-steps">
      {buildSteps.map((step) => (
        <li><strong>{step.title}</strong> {step.desc}</li>
      ))}
    </ol>
    <div class="cta section-cta">
      <LinkButton href={projectEmail} variant="primary">Start with a project note</LinkButton>
      <LinkButton href="/projects/">See what I have shipped</LinkButton>
    </div>
  </section>

  <section class="wrap" id="coaching">
    <SectionHeading
      title="Want to build it with me instead?"
      note="Live teaching on your real work, not a course you watch alone."
    />
    <ul class="who flow">
      <li>People who want to build something real and keep bouncing off tutorials.</li>
      <li>Working professionals who want to use AI on the actual job, not a toy demo.</li>
      <li>Small teams who want to get better together.</li>
    </ul>
    <p class="pull">If you have been meaning to learn this for a year, an hour with a person beats another month of open tabs.</p>
  </section>

  <section class="wrap" id="tracks">
    <SectionHeading
      title="What you'll learn"
      note="Three tracks. Pick one, or mix them across sessions."
    />
    <div class="grid">
      {tracks.map((t, i) => (
        <article class="surface card reveal" style={`--i: ${i}`}>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap">
    <SectionHeading title="Formats" />
    <ul class="formats flow">
      <li><strong>One-on-one.</strong> Live, screen-shared, your pace.</li>
      <li><strong>Small group, two to four.</strong> Learn with your team or your friends at a lower cost per person.</li>
      <li><strong>Workshop, five to ten.</strong> One focused topic for a group.</li>
      <li><strong>More than once.</strong> Most people book again, because skills compound. Recurring is the point, not the exception.</li>
    </ul>
  </section>

  <section class="wrap">
    <SectionHeading
      title="What I've built with these tools"
      note="No testimonials yet. Here is the work instead."
    />
    <p class="proof-lede">
      I teach the tools I use every day. Here is what I have shipped with them, live right now. I
      will teach you to build like this.
    </p>
    <div class="proof-grid">
      {shipped.map((p) => (
        <a class="surface proof-card" href={p.href} target="_blank" rel="noopener">
          <span class="dot live" aria-hidden="true"></span>
          <span class="proof-name">{p.name}</span>
          <span class="proof-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
    <p class="proof-more"><a href="/projects/">More on the projects page.</a></p>
  </section>

  <section class="wrap" id="pricing">
    <SectionHeading
      title="What it costs"
      note="The half hour books itself. Everything else, send a note and I set it up with you."
    />
    <div class="prices">
      {pricing.map((p) => (
        <article class="surface price-row">
          <div class="price-head">
            <h3>{p.name}</h3>
            <span class="amount">{p.price}</span>
          </div>
          <p>{p.desc}</p>
          <LinkButton href={p.href} variant={p.selfServe ? 'primary' : 'default'}>
            {p.cta}
          </LinkButton>
        </article>
      ))}
    </div>
    <p class="boundary">
      Sessions run from a half hour up to four hours. Anything longer than a single half hour,
      spread across days, or for a group needs a quick email first so I can block the right time.
      Every engagement gets scoped to fit. Already paid for your half hour?
      <a href={BOOKING_URL} target="_blank" rel="noopener">Book your slot here.</a>
    </p>
  </section>

  <section class="wrap">
    <SectionHeading title="How it works" />
    <ol class="steps flow">
      <li><strong>Pick your session.</strong> The half hour is ready to book right now. For anything longer or for a group, send me a note and I get you set up.</li>
      <li><strong>Pay.</strong> Secure Stripe checkout. You and I both get an emailed receipt, and that receipt confirms your spot.</li>
      <li><strong>Book your time.</strong> After payment, grab a slot on my calendar. You get a calendar invite and a reminder.</li>
    </ol>
  </section>

  <section class="wrap">
    <SectionHeading title="Is this a fit?" />
    <div class="flow">
      <p>
        Good fit if you want to learn by building real things, you like a patient person who
        explains the why, and you would rather understand the tool than buy a shortcut.
      </p>
      <p>
        One honest thing. If your problem is bigger than a session can solve, I will say so, and I
        will point you somewhere better.
      </p>
    </div>
    <p class="pull">I don't fix your mistakes. I teach you to not need me.</p>
  </section>

  <section class="wrap">
    <SectionHeading title="Questions" />
    <dl class="faq">
      {faqs.map((f) => (
        <div class="faq-item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap final">
    <SectionHeading title="Bring the thing you keep meaning to learn" />
    <p class="final-copy">
      We will build it together, and you will leave able to keep building. Start with a half hour.
      If you want the longer version or a group, email me first.
    </p>
    <div class="cta">
      <LinkButton href={STRIPE_HALF_HOUR} variant="primary">Book a half hour</LinkButton>
      <LinkButton href={bookingEmail('Session question')}>Email me first</LinkButton>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vh, 6rem) clamp(2rem, 6vh, 4rem);
    display: grid;
    gap: calc(var(--space) * 3);
  }

  .now {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .now .dot {
    margin-right: 0.35em;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.7;
    color: oklch(84% 0.01 95);
    max-width: 52ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .who,
  .formats {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .who li {
    padding-inline-start: 1.5rem;
    position: relative;
    color: var(--ink-soft);
  }

  .who li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .formats li {
    color: var(--ink-soft);
  }

  .formats strong {
    color: var(--ink);
  }

  .pull {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--ink);
    max-width: 30ch;
    margin-top: calc(var(--space) * 5);
    text-wrap: balance;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: calc(var(--space) * 3);
  }

  .card {
    padding: calc(var(--space) * 4);
    display: flex;
    flex-direction: column;
    gap: calc(var(--space) * 1.5);
  }

  .card h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .card p {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .services-grid {
    align-items: stretch;
  }

  .service-fit {
    margin-top: calc(var(--space) * 3);
    padding: calc(var(--space) * 3.5) calc(var(--space) * 4);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: calc(var(--space) * 4);
  }

  .service-fit h3 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: calc(var(--space) * 1);
  }

  .service-fit p {
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .build-steps {
    max-width: 52rem;
  }

  .section-cta {
    margin-top: calc(var(--space) * 4);
  }

  .proof-lede {
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .proof-grid {
    margin-top: calc(var(--space) * 4);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: calc(var(--space) * 2);
  }

  .proof-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: calc(var(--space) * 2.5) calc(var(--space) * 3);
    text-decoration: none;
    color: var(--ink);
  }

  .proof-name {
    font-weight: 600;
    font-size: 0.98rem;
  }

  .proof-arrow {
    margin-left: auto;
    color: var(--ink-faint);
  }

  .proof-more {
    margin-top: calc(var(--space) * 3);
    font-size: 0.95rem;
  }

  .prices {
    display: grid;
    gap: calc(var(--space) * 2.5);
  }

  .price-row {
    padding: calc(var(--space) * 3.5) calc(var(--space) * 4);
    display: grid;
    gap: calc(var(--space) * 1.5);
    align-items: start;
  }

  .price-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .price-head h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .amount {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .price-row p {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.65;
    max-width: 52ch;
  }

  .price-row :global(.btn) {
    justify-self: start;
    margin-top: calc(var(--space) * 1);
  }

  .boundary {
    margin-top: calc(var(--space) * 5);
    padding: calc(var(--space) * 3) calc(var(--space) * 4);
    border-inline-start: 3px solid var(--amber);
    background: var(--bg-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.98rem;
    color: var(--ink-soft);
    line-height: 1.7;
    max-width: none;
  }

  .steps {
    list-style: none;
    padding: 0;
    counter-reset: step;
    max-width: var(--measure);
  }

  .steps li {
    counter-increment: step;
    padding-inline-start: 2.5rem;
    position: relative;
    color: var(--ink-soft);
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.15rem;
    width: 1.6rem;
    height: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-tint);
    border-radius: 50%;
  }

  .steps strong {
    color: var(--ink);
  }

  .faq {
    display: grid;
    gap: calc(var(--space) * 3);
    max-width: var(--measure);
  }

  .faq-item dt {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: calc(var(--space) * 0.5);
  }

  .faq-item dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .final {
    padding-block-end: clamp(4rem, 10vh, 7rem);
  }

  .final-copy {
    max-width: 48ch;
    color: var(--ink-soft);
    line-height: 1.7;
    margin-bottom: calc(var(--space) * 3);
  }
</style>
