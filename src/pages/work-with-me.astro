---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LinkButton from '../components/LinkButton.astro';

// ============================================================
// Booking + payment links. Public URLs, safe to commit.
// The half hour is the only self-serve path: pay, then book a slot.
// Anything longer than 30 minutes or for a group is arranged by email.
// ============================================================
const BOOKING_URL = 'https://calendar.app.google/HnkQMCj9ykUGUhoi6';
const STRIPE_HALF_HOUR = 'https://buy.stripe.com/9B6dR92WvcoZ4Vw8BS08g09';
const EMAIL = 'jeffkazzee@gmail.com';

// Payment links to send after someone emails for a longer or group session:
//   One hour ($65):            https://buy.stripe.com/fZu4gzeFddt3fAa6tK08g0a
//   Three-session pack ($100): https://buy.stripe.com/7sYbJ168H74Few69FW08g08

const bookingEmail = (subject: string) =>
  `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(
    'What do you want to work on?\nHow many people?\nWhich days and times work for you?\n',
  )}`;

const tracks = [
  {
    title: 'Learn to code with AI',
    desc: 'Start with little or no coding experience. Use Cursor and Claude on your own project. Practise reading code, changing it and checking what it does.',
  },
  {
    title: 'Use AI for real work',
    desc: 'Bring a task from your job: research, writing, data, documentation or automation. We work through the task and check the output.',
  },
  {
    title: 'Build something real',
    desc: 'Bring an idea for a tool, website or automation. You share your screen and build while I explain the next step.',
  },
];

const pricing = [
  {
    name: 'Half hour',
    price: '$40',
    desc: 'One half-hour session for one problem, with a shared screen.',
    cta: 'Pay and book',
    href: STRIPE_HALF_HOUR,
    selfServe: true,
  },
  {
    name: 'One hour',
    price: '$65',
    desc: 'Two thirty-minute blocks, back to back. Email me first to arrange the time.',
    cta: 'Email to book an hour',
    href: bookingEmail('Booking an hour session'),
    selfServe: false,
  },
  {
    name: 'Three-session pack',
    price: '$100',
    desc: 'Three half-hour sessions. Email me to arrange the dates.',
    cta: 'Email to arrange',
    href: bookingEmail('Three-session pack'),
    selfServe: false,
  },
  {
    name: 'Groups and workshops',
    price: 'from $25 / person',
    desc: 'Two to four people: $35 per person per hour. Five to ten people: $25 per person per hour. Email me the group size and topic.',
    cta: 'Email about a group',
    href: bookingEmail('Group session or workshop'),
    selfServe: false,
  },
];

// Derived from the project collection, never hand-listed. Two entries here
// were dead links for months because nothing checked them. Anything shown
// carries a `verified` date from `npm run verify:projects`.
const shipped = (await getCollection('projects'))
  .filter((p) => p.data.status === 'shipped' && !p.data.archived && p.data.liveUrl)
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({ name: p.data.title, href: p.data.liveUrl as string }));

const faqs = [
  {
    q: 'Do I need experience?',
    a: 'No. You can start with no coding experience.',
  },
  {
    q: 'What do I need installed?',
    a: 'Nothing to begin. If we need a tool, we set it up together on the call.',
  },
  {
    q: 'Can my team book together?',
    a: 'Yes. Two to four people can book a small group. Five to ten can book a workshop. Both cost less per person than a one-on-one hour.',
  },
  {
    q: 'Can I reschedule?',
    a: 'Yes. Give me at least 24 hours notice, and we will arrange a new time.',
  },
  {
    q: 'Refunds?',
    a: 'If your first session is not useful, tell me and I will refund it.',
  },
];
---

<BaseLayout
  title="Learn to build with AI, live with Jeff Kazzee"
  hero={{ title: "You don't need a degree to build with AI. You need an hour and someone who has done it." }}
  description="Live coaching with a shared screen. Learn to code, use AI for a work task or build a project. One-on-one, small-group and workshop sessions."
>
  <div slot="hero-meta">
    <p class="now rise" style="--i: 0">
      <span class="dot" aria-hidden="true"></span>
      One-on-one and group sessions, live and screen-shared
    </p>
    <p class="lede rise" style="--i: 2">
      Bring a project, a task from work or an idea you want to try. We work on it together on a live call. You share your screen, make the changes and ask questions as we go.
    </p>
    <div class="cta rise" style="--i: 3">
      <LinkButton href="#pricing" variant="primary">Reserve a session</LinkButton>
      <LinkButton href="#tracks">See what you'll learn</LinkButton>
    </div>
  </div>

  <section class="wrap">
    <SectionHeading
      title="Who this is for"
      note="These sessions teach you to use AI. They are not a code-cleanup service."
    />
    <ul class="who flow">
      <li>People who want to build a project and need help getting past tutorials.</li>
      <li>Working professionals who want to use AI for tasks from their own jobs.</li>
      <li>Small teams who want to learn together.</li>
    </ul>
    <p class="pull">If you have been meaning to learn this for a year, an hour with a person beats another month of open tabs.</p>
  </section>

  <section class="wrap" id="tracks">
    <SectionHeading
      title="What you'll learn"
      note="Choose one track, or use different tracks across sessions."
    />
    <div class="grid">
      {tracks.map((t, i) => (
        <article class="surface card reveal" style={`--i: ${i}`}>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap">
    <SectionHeading title="Formats" />
    <ul class="formats flow">
      <li><strong>One-on-one.</strong> We share a screen and work at your pace.</li>
      <li><strong>Small group, two to four.</strong> Learn with your team or friends at a lower cost per person.</li>
      <li><strong>Workshop, five to ten.</strong> Work through one topic as a group.</li>
      <li><strong>More than once.</strong> Book separate sessions for work spread across days. The three-session pack includes three half-hour calls.</li>
    </ul>
  </section>

  <section class="wrap">
    <SectionHeading
      title="What I've built with these tools"
      note="See the projects below for examples of my work."
    />
    <p class="proof-lede">
      I build software with AI coding agents. These project links show examples from my portfolio.
    </p>
    <div class="proof-grid">
      {shipped.map((p) => (
        <a class="surface proof-card" href={p.href} target="_blank" rel="noopener">
          <span class="dot live" aria-hidden="true"></span>
          <span class="proof-name">{p.name}</span>
          <span class="proof-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
    <p class="proof-more"><a href="/projects/">More on the projects page.</a></p>
  </section>

  <section class="wrap" id="pricing">
    <SectionHeading
      title="What it costs"
      note="You can pay and book a half hour online. Email me for all other formats."
    />
    <div class="prices">
      {pricing.map((p) => (
        <article class="surface price-row">
          <div class="price-head">
            <h3>{p.name}</h3>
            <span class="amount">{p.price}</span>
          </div>
          <p>{p.desc}</p>
          <LinkButton href={p.href} variant={p.selfServe ? 'primary' : 'default'}>
            {p.cta}
          </LinkButton>
        </article>
      ))}
    </div>
    <p class="boundary">
      Sessions last from half an hour to four hours. Email me first for anything longer than one half hour, spread across days or for a group. We set the scope to fit the session. Already paid for your half hour? <a href={BOOKING_URL} target="_blank" rel="noopener">Book your slot here.</a>
    </p>
  </section>

  <section class="wrap">
    <SectionHeading title="How it works" />
    <ol class="steps flow">
      <li><strong>Pick your session.</strong> You can book a half hour online. Email me to arrange anything longer or a group.</li>
      <li><strong>Pay.</strong> Use the Stripe checkout. You and I both get an email receipt. It confirms your session.</li>
      <li><strong>Book your time.</strong> After payment, choose a slot on my calendar. You get a calendar invite and a reminder.</li>
    </ol>
  </section>

  <section class="wrap">
    <SectionHeading title="Is this a fit?" />
    <div class="flow">
      <p>
        You want to learn by building, with someone who explains each step. You want to understand the tools, not hand off the whole job.
      </p>
      <p>
        If the problem is too large for a session, I will say so and suggest where to look next.
      </p>
    </div>
    <p class="pull">I don't fix your mistakes. I teach you to not need me.</p>
  </section>

  <section class="wrap">
    <SectionHeading title="Questions" />
    <dl class="faq">
      {faqs.map((f) => (
        <div class="faq-item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="wrap final">
    <SectionHeading title="Bring the thing you keep meaning to learn" />
    <p class="final-copy">
      Start with a half hour. Bring a task or an idea, and we will work on it together. Email me first for a longer session or a group.
    </p>
    <div class="cta">
      <LinkButton href={STRIPE_HALF_HOUR} variant="primary">Book a half hour</LinkButton>
      <LinkButton href={bookingEmail('Session question')}>Email me first</LinkButton>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vh, 6rem) clamp(2rem, 6vh, 4rem);
    display: grid;
    gap: calc(var(--space) * 3);
  }

  .now {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .now .dot {
    margin-right: 0.35em;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.7;
    color: oklch(84% 0.01 95);
    max-width: 52ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .who,
  .formats {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .who li {
    padding-inline-start: 1.5rem;
    position: relative;
    color: var(--ink-soft);
  }

  .who li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .formats li {
    color: var(--ink-soft);
  }

  .formats strong {
    color: var(--ink);
  }

  .pull {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--ink);
    max-width: 30ch;
    margin-top: calc(var(--space) * 5);
    text-wrap: balance;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: calc(var(--space) * 3);
  }

  .card {
    padding: calc(var(--space) * 4);
    display: flex;
    flex-direction: column;
    gap: calc(var(--space) * 1.5);
  }

  .card h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .card p {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .proof-lede {
    color: var(--ink-soft);
    max-width: 48ch;
  }

  .proof-grid {
    margin-top: calc(var(--space) * 4);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: calc(var(--space) * 2);
  }

  .proof-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: calc(var(--space) * 2.5) calc(var(--space) * 3);
    text-decoration: none;
    color: var(--ink);
  }

  .proof-name {
    font-weight: 600;
    font-size: 0.98rem;
  }

  .proof-arrow {
    margin-left: auto;
    color: var(--ink-faint);
  }

  .proof-more {
    margin-top: calc(var(--space) * 3);
    font-size: 0.95rem;
  }

  .prices {
    display: grid;
    gap: calc(var(--space) * 2.5);
  }

  .price-row {
    padding: calc(var(--space) * 3.5) calc(var(--space) * 4);
    display: grid;
    gap: calc(var(--space) * 1.5);
    align-items: start;
  }

  .price-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .price-head h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .amount {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .price-row p {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.65;
    max-width: 52ch;
  }

  .price-row :global(.btn) {
    justify-self: start;
    margin-top: calc(var(--space) * 1);
  }

  .boundary {
    margin-top: calc(var(--space) * 5);
    padding: calc(var(--space) * 3) calc(var(--space) * 4);
    border-inline-start: 3px solid var(--amber);
    background: var(--bg-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.98rem;
    color: var(--ink-soft);
    line-height: 1.7;
    max-width: none;
  }

  .steps {
    list-style: none;
    padding: 0;
    counter-reset: step;
    max-width: var(--measure);
  }

  .steps li {
    counter-increment: step;
    padding-inline-start: 2.5rem;
    position: relative;
    color: var(--ink-soft);
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.15rem;
    width: 1.6rem;
    height: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-tint);
    border-radius: 50%;
  }

  .steps strong {
    color: var(--ink);
  }

  .faq {
    display: grid;
    gap: calc(var(--space) * 3);
    max-width: var(--measure);
  }

  .faq-item dt {
    font-weight: 600;
    color: var(--ink);
    margin-bottom: calc(var(--space) * 0.5);
  }

  .faq-item dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .final {
    padding-block-end: clamp(4rem, 10vh, 7rem);
  }

  .final-copy {
    max-width: 48ch;
    color: var(--ink-soft);
    line-height: 1.7;
    margin-bottom: calc(var(--space) * 3);
  }
</style>
