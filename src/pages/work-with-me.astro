---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LinkButton from '../components/LinkButton.astro';

const EMAIL = 'jeffkazzee@gmail.com';
const inquiryUrl = `mailto:${EMAIL}?subject=${encodeURIComponent('Project inquiry')}`;

const offers = [
  {
    title: 'Websites',
    desc: 'A clear, fast site for a product, a small business, or a project that needs a home. I can help shape the content, build the site, and hand over the source.',
  },
  {
    title: 'Small tools',
    desc: 'A focused internal tool or small app that removes a repeated bit of work. We keep the scope narrow enough to finish.',
  },
  {
    title: 'AI workflows',
    desc: 'A practical workflow around research, writing, data, or a repetitive task. The point is a system you can understand and change, not a magic button.',
  },
];
---

<BaseLayout
  title="Work with me: Jeff Kazzee"
  description="Jeff Kazzee builds small websites, tools, and AI workflows for people with a concrete problem."
>
  <section class="hero wrap">
    <p class="now rise" style="--i: 0">
      <span class="dot" aria-hidden="true"></span>
      Paid websites, small tools, and AI workflows
    </p>
    <h1 class="rise" style="--i: 1">I build the first useful version.</h1>
    <p class="lede rise" style="--i: 2">
      Have a clear problem, a rough idea, or a process that is wasting your time? I can help turn
      it into a small website, tool, or workflow. Start with an email. I will reply with whether I
      am the right person, the scope I would suggest, and what it would cost.
    </p>
    <div class="cta rise" style="--i: 3">
      <LinkButton href={inquiryUrl} variant="primary">Start a conversation</LinkButton>
      <LinkButton href="/projects/">See the work</LinkButton>
    </div>
  </section>

  <section class="wrap" id="offers">
    <SectionHeading
      title="What I can help build"
      note="These are the things I build now."
    />
    <div class="grid">
      {offers.map((offer, i) => (
        <article class="surface card reveal" style={`--i: ${i}`}>
          <h3>{offer.title}</h3>
          <p>{offer.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap">
    <SectionHeading
      title="How I work"
      note="Each project differs. The order usually does not."
    />
    <ol class="steps flow">
      <li>
        <strong>Start with the problem.</strong> Send a few lines about what you want to change,
        who uses it, and what you have tried already.
      </li>
      <li>
        <strong>Cut the scope.</strong> I will suggest the smallest version worth building and say
        what I would leave out for now.
      </li>
      <li>
        <strong>Build and review.</strong> We work in short checkpoints and review working pieces
        as we go.
      </li>
      <li>
        <strong>Hand it over.</strong> You get the source, practical notes, and a walkthrough of
        what is there and what could come next.
      </li>
    </ol>
  </section>

  <section class="wrap">
    <SectionHeading title="A good first note" />
    <div class="flow">
      <p>
        You do not need a polished brief. Tell me what is frustrating, what the current workaround
        looks like, and what you need the first version to do.
      </p>
      <ul class="formats">
        <li>What are you trying to make or fix?</li>
        <li>Who needs to use it?</li>
        <li>What would make the first version useful?</li>
        <li>Is there a deadline or a constraint I should know about?</li>
      </ul>
    </div>
    <p class="pull">A rough problem is enough to start. We can make the brief clearer together.</p>
  </section>

  <section class="wrap">
    <SectionHeading title="When it is not a fit" />
    <p class="boundary">
      I am not a 24/7 support desk or a full product team. If the project needs a large build,
      ongoing operations, or too many unknowns to define a first deliverable, I will say that early.
    </p>
  </section>

  <section class="wrap final">
    <SectionHeading title="Have a project in mind?" />
    <p class="final-copy">
      Send the rough version. I will reply with whether I can help and what I would suggest doing
      first.
    </p>
    <div class="cta">
      <LinkButton href={inquiryUrl} variant="primary">Email about a project</LinkButton>
      <LinkButton href="/projects/">Browse projects</LinkButton>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vh, 6rem) clamp(2rem, 6vh, 4rem);
    display: grid;
    gap: calc(var(--space) * 3);
  }

  .now {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .now .dot {
    margin-right: 0.35em;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: calc(var(--space) * 3);
  }

  .card {
    padding: calc(var(--space) * 4);
    display: flex;
    flex-direction: column;
    gap: calc(var(--space) * 1.5);
  }

  .card h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .card p {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .formats {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .formats li {
    padding-inline-start: 1.5rem;
    position: relative;
  }

  .formats li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .pull {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--ink);
    max-width: 30ch;
    margin-top: calc(var(--space) * 5);
    text-wrap: balance;
  }

  .boundary {
    padding: calc(var(--space) * 3) calc(var(--space) * 4);
    border-inline-start: 3px solid var(--amber);
    background: var(--bg-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.98rem;
    color: var(--ink-soft);
    line-height: 1.7;
    max-width: none;
  }

  .steps {
    list-style: none;
    padding: 0;
    counter-reset: step;
    max-width: var(--measure);
  }

  .steps li {
    counter-increment: step;
    padding-inline-start: 2.5rem;
    position: relative;
    color: var(--ink-soft);
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.15rem;
    width: 1.6rem;
    height: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-tint);
    border-radius: 50%;
  }

  .steps strong {
    color: var(--ink);
  }

  .final {
    padding-block-end: clamp(4rem, 10vh, 7rem);
  }

  .final-copy {
    max-width: 48ch;
    color: var(--ink-soft);
    line-height: 1.7;
    margin-bottom: calc(var(--space) * 3);
  }
</style>
