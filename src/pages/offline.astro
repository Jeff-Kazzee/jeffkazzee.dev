---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Offline · Jeff Kazzee"
  description="This page is not saved on this device yet."
  noindex
>
  <section class="wrap offline">
    <h1>You're offline.</h1>
    <p>
      This page isn't saved on this device yet. Pages you've already opened here still work, and so do
      the home page, projects, writing, and contact pages.
    </p>
    <p><a href="/">Back to the home page</a></p>
  </section>
</BaseLayout>

<style>
  .offline {
    padding-block: clamp(4rem, 12vh, 7rem);
    display: grid;
    gap: calc(var(--space) * 2);
  }

  .offline p {
    color: var(--ink-soft);
    max-width: 52ch;
  }
</style>
