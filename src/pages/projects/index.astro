---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const allProjects = await getCollection('projects');
const hasScreenshots = (project: typeof allProjects[number]) => project.data.screenshots.length > 0;

const projects = allProjects.sort((a, b) => {
  if (hasScreenshots(a) !== hasScreenshots(b)) return hasScreenshots(a) ? -1 : 1;
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout
  title="Projects — jeffkazzee.dev"
  description="A working portfolio of local-first AI tools, agent-workspace infrastructure, open data, web experiments, and things built on a Zo computer."
>
  <section class="wrap">
    <SectionHeading
      title="Projects"
      level="h1"
      note={`${projects.length} entries. Screenshot-backed work appears first; quieter tooling lives further down.`}
    />
    <div class="grid">
      {projects.map((p, i) => (
        <ProjectCard project={p} index={i % 6} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: calc(var(--space) * 4);
  }
</style>
