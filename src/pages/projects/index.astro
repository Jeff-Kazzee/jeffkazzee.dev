---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const allProjects = await getCollection('projects');
const byOrder = (a: typeof allProjects[number], b: typeof allProjects[number]) =>
  a.data.order - b.data.order;
const studioProjects = allProjects
  .filter((project) => project.data.portfolioGroup === 'studio')
  .sort(byOrder);
const zoProjects = allProjects
  .filter((project) => project.data.portfolioGroup === 'zo')
  .sort(byOrder);
const projectCount = studioProjects.length + zoProjects.length;
---

<BaseLayout
  title="Projects — jeffkazzee.dev"
  description="A working portfolio of agent workspaces, local-first AI memory, practical learning tools, and public Zo resources."
>
  <section class="wrap">
    <SectionHeading
      title="Projects"
      level="h1"
      note={`${projectCount} projects with live demos, working software, and public source where available.`}
    />
    <section class="project-section" aria-labelledby="studio-projects">
      <SectionHeading
        title="Core products"
        id="studio-projects"
        note="Vivary and Bellamente lead the portfolio, followed by Journeyman."
      />
      <div class="rows">
        {studioProjects.map((project, index) => (
          <ProjectCard project={project} index={index} variant="row" />
        ))}
      </div>
    </section>

    <section class="project-section" aria-labelledby="zo-projects">
      <SectionHeading
        title="Built on Zo"
        id="zo-projects"
        note="Public resources and small tools built from real use."
      />
      <div class="grid">
        {zoProjects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .project-section + .project-section {
    margin-top: calc(var(--space) * 7);
  }

  .rows {
    border-bottom: 1px solid var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: calc(var(--space) * 4);
  }
</style>
