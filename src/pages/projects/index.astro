---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const allProjects = await getCollection('projects');
type Project = (typeof allProjects)[number];

const hasScreenshots = (project: Project) => project.data.screenshots.length > 0;

const rank = (a: Project, b: Project) => {
  if (hasScreenshots(a) !== hasScreenshots(b)) return hasScreenshots(a) ? -1 : 1;
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.date.valueOf() - a.data.date.valueOf();
};

const active = allProjects.filter((p) => !p.data.archived).sort(rank);
const archived = allProjects.filter((p) => p.data.archived).sort(rank);
---

<BaseLayout
  title="Projects · Jeff Kazzee"
  description="Games built by AI agents, free guide libraries, open tools and data, web experiments, and things built on a Zo computer."
>
  <section class="wrap">
    <SectionHeading
      title="Projects"
      level="h1"
      note={`${active.length} active, ${archived.length} archived. The arcade and the guides first, then tooling, experiments, and demos.`}
    />
    <div class="grid">
      {active.map((p, i) => (
        <ProjectCard project={p} index={i % 6} />
      ))}
    </div>
  </section>

  {
    archived.length > 0 && (
      <section class="wrap">
        <SectionHeading
          title="Archive"
          note="Earlier work, kept for the record. Not under active development and not where the current attention is."
        />
        <ul class="archive" role="list">
          {archived.map((p) => (
            <li>
              <a href={`/projects/${p.id}/`}>{p.data.title}</a>
              <p>{p.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: calc(var(--space) * 4);
  }

  .archive {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .archive li {
    display: grid;
    gap: calc(var(--space) * 0.5);
    padding-block: calc(var(--space) * 2.5);
    border-top: 1px solid var(--line);
  }

  .archive li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .archive a {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 560;
    color: var(--ink-soft);
    text-decoration: none;
    justify-self: start;
  }

  .archive a:hover {
    color: var(--accent);
  }

  .archive p {
    font-size: 0.92rem;
    color: var(--ink-faint);
    max-width: 62ch;
  }
</style>
