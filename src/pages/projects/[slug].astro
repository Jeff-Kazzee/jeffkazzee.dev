---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StackBadges from '../../components/StackBadges.astro';
import LinkButton from '../../components/LinkButton.astro';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const wip = d.status !== 'shipped';
const statusLabel = d.status.replaceAll('-', ' ');
const projectUrl = new URL(`/projects/${project.id}/`, Astro.site).href;
const projectLinks = Array.from(
  new Set(
    [d.liveUrl, d.repoUrl, d.releaseUrl].filter(
      (url): url is string => typeof url === 'string',
    ),
  ),
);
const projectJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${projectUrl}#project`,
  name: d.title,
  description: d.description,
  url: projectUrl,
  dateCreated: d.date.toISOString(),
  creativeWorkStatus: statusLabel,
  author: {
    '@type': 'Person',
    name: 'Jeff Kazzee',
    url: 'https://jeffkazzee.dev',
  },
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://jeffkazzee.dev/#website',
    name: 'jeffkazzee.dev',
    url: 'https://jeffkazzee.dev',
  },
  ...(d.tags.length > 0 ? { keywords: d.tags } : {}),
  ...(projectLinks.length > 0 ? { sameAs: projectLinks } : {}),
}).replaceAll('<', '\\u003c');
---

<BaseLayout
  title={`${d.title} | jeffkazzee.dev`}
  description={d.description}
  robots={d.visibility === 'archived' ? 'noindex,follow' : undefined}
>
  <script type="application/ld+json" set:html={projectJsonLd} is:inline />

  <article class="wrap">
    <header>
      <p class="crumb"><a href="/projects/">← All projects</a></p>
      <h1>{d.title}</h1>
      <p class="status">
        <span class="dot" data-tone={wip ? 'wip' : undefined} aria-hidden="true"></span>
        {statusLabel}{d.builtOn === 'zo' && ' · built on a Zo computer'} · <FormattedDate date={d.date} />
      </p>
    </header>

    <div class="meta">
      {d.stack.length > 0 && (
        <div class="meta-row">
          <h2 class="meta-label">Stack</h2>
          <StackBadges items={d.stack} />
        </div>
      )}
      {d.tags.length > 0 && (
        <div class="meta-row">
          <h2 class="meta-label">Tags</h2>
          <p>{d.tags.join(' · ')}</p>
        </div>
      )}
    </div>

    <nav class="actions" aria-label="Project links">
      {d.releaseUrl && (
        <LinkButton href={d.releaseUrl} variant={d.status === 'archived' ? 'default' : 'primary'}>
          {d.status === 'archived' ? 'View archived release' : 'Download for Windows'}
        </LinkButton>
      )}
      {d.liveUrl && (
        <LinkButton href={d.liveUrl} variant={d.releaseUrl && d.status !== 'archived' ? 'default' : 'primary'}>
          Visit live site
        </LinkButton>
      )}
      {d.repoUrl && <LinkButton href={d.repoUrl}>Source</LinkButton>}
    </nav>

    <ScreenshotGallery screenshots={d.screenshots} />

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    padding-block: clamp(2.5rem, 7vh, 4rem) calc(var(--space) * 5);
    display: grid;
    gap: calc(var(--space) * 4);
  }

  header {
    display: grid;
    gap: calc(var(--space) * 2);
  }

  .crumb a {
    font-size: 0.9rem;
    color: var(--ink-faint);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--accent);
  }

  .status {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .meta {
    display: grid;
    gap: calc(var(--space) * 2);
    border-block: 1px solid var(--line);
    padding-block: calc(var(--space) * 3);
  }

  .meta-row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  .meta-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .meta-row p {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space) * 1.5);
  }

  .prose {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-block: calc(var(--space) * 5) calc(var(--space) * 2);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block-end: calc(var(--space) * 2.5);
    max-width: var(--measure);
  }
</style>
