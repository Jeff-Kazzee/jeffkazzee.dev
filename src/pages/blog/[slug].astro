---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const localUrl = new URL(`/blog/${post.id}/`, Astro.site).href;
const canonicalUrl = d.canonicalUrl ?? localUrl;
const postJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  headline: d.title,
  description: d.description,
  url: canonicalUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  datePublished: d.pubDate.toISOString(),
  ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: 'Jeff Kazzee',
    url: 'https://jeffkazzee.dev',
    sameAs: [
      'https://github.com/Jeff-Kazzee',
      'https://x.com/jeffkazzee',
      'https://jeffkazzee.substack.com',
    ],
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': 'https://jeffkazzee.dev/blog/#blog',
    name: 'Writing by Jeff Kazzee',
    url: 'https://jeffkazzee.dev/blog/',
  },
  ...(d.tags.length > 0 ? { keywords: d.tags } : {}),
}).replaceAll('<', '\\u003c');
---

<BaseLayout
  title={`${d.title} | jeffkazzee.dev`}
  description={d.description}
  ogType="article"
  canonicalUrl={d.canonicalUrl}
>
  <script type="application/ld+json" set:html={postJsonLd} is:inline />

  <article class="wrap">
    <header>
      <p class="crumb"><a href="/blog/">← All writing</a></p>
      <h1>{d.title}</h1>
      <p class="meta">
        <FormattedDate date={d.pubDate} />
        {d.updatedDate && (
          <>
            {' · updated '}
            <FormattedDate date={d.updatedDate} />
          </>
        )}
        {d.canonicalUrl && (
          <>
            {' · originally on '}
            <a href={d.canonicalUrl} rel="noopener">Substack</a>
          </>
        )}
      </p>
    </header>

    {d.heroImage && d.heroAlt && (
      <Image
        class="hero-image"
        src={d.heroImage}
        alt={d.heroAlt}
        widths={[640, 960, 1280, 1536]}
        sizes="(max-width: 900px) 100vw, 800px"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
    )}

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    padding-block: clamp(2.5rem, 7vh, 4rem) calc(var(--space) * 5);
    display: grid;
    gap: calc(var(--space) * 5);
    max-width: calc(var(--measure) + 8rem);
  }

  header {
    display: grid;
    gap: calc(var(--space) * 2);
  }

  .crumb a {
    font-size: 0.9rem;
    color: var(--ink-faint);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
  }

  .meta {
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .hero-image {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .prose {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-block: calc(var(--space) * 5) calc(var(--space) * 2);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-block-end: calc(var(--space) * 2.5);
    max-width: var(--measure);
  }

  .prose :global(img) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    margin-block: calc(var(--space) * 4);
  }

  .prose :global(a) {
    text-decoration-thickness: 1px;
  }
</style>
