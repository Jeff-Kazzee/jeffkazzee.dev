---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Writing | jeffkazzee.dev"
  description="Essays and field notes by Jeff Kazzee about software, AI-assisted building, learning, and the work behind the projects."
>
  <section class="wrap">
    <SectionHeading title="Writing" level="h1" note="Essays and field notes from building, learning, and paying attention." />
    <p class="note">
      New posts publish here first. Older essays may still point to the original
      <a href="https://jeffkazzee.substack.com" rel="noopener">Substack</a> edition.
    </p>
    <div class="posts">
      {posts.map((post, i) => (
        <PostCard post={post} index={i % 6} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .note {
    color: var(--ink-soft);
    font-size: 0.97rem;
    margin-bottom: calc(var(--space) * 5);
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: calc(var(--space) * 3);
  }
</style>
