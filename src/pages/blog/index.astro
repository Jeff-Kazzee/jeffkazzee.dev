---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getGuides } from '../../lib/content-index';
import { getWriting } from '../../lib/writing';
const guides = await getGuides();

const posts = await getWriting();
---

<BaseLayout
  title="Writing · jeffkazzee.dev"
  hero={{ title: 'Writing', description: 'Essays and field notes on AI-assisted building.' }}
  description="Essays and field notes on AI-assisted building: what worked, what didn't, and the path actually taken. Originals on Substack, mirrored here."
>
  <section class="wrap">

    <p class="note">
      The essays below have originals on <a href="https://jeffkazzee.substack.com" rel="noopener">Substack</a>,
      mirrored here so the archive lives on a URL I control. A post marked On Substack is not mirrored yet,
      so its link goes to Substack.
    </p>
    <p class="note"><a href="/deepseek-harness/">DeepSeek Harness</a> has guides, build notes, and ideas about plugins and practical harness tweaks.
      {guides.length > 0 && ` ${guides.length} published ${guides.length === 1 ? 'guide' : 'guides'}.`}
    </p>
    <div class="posts">
      <template id="writing-start"></template>
      {posts.map((post, i) => (
        <PostCard post={post} index={i % 6} />
      ))}
      <template id="writing-end"></template>
    </div>
  </section>
</BaseLayout>

<style>
  .note {
    color: var(--ink-soft);
    font-size: 0.97rem;
    margin-bottom: calc(var(--space) * 5);
  }

  .posts {
    border-bottom: 1px solid var(--line);
  }
</style>
