---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import earthrise from '../assets/earthrise.avif';

const projects = await getCollection('projects');
const byOrder = (a: typeof projects[number], b: typeof projects[number]) =>
  a.data.order - b.data.order;

const featured = projects.filter((p) => p.data.featured && !p.data.builtOn).sort(byOrder);
const zoShelf = projects.filter((p) => p.data.builtOn === 'zo').sort(byOrder);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const links = [
  { href: 'https://github.com/Jeff-Kazzee', label: 'GitHub' },
  { href: 'https://x.com/jeffkazzee', label: 'X' },
  { href: 'https://jeffkazzee.substack.com', label: 'Substack' },
  { href: 'mailto:jeffkazzee@gmail.com', label: 'Email' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jeff Kazzee',
  url: 'https://jeffkazzee.dev',
  sameAs: [
    'https://github.com/Jeff-Kazzee',
    'https://x.com/jeffkazzee',
    'https://jeffkazzee.substack.com',
    'https://jeffkazzee.zo.space',
  ],
});
---

<BaseLayout
  title="Jeff Kazzee — builds tools, games, and weird useful things with AI"
  description="Self-taught builder. Desktop apps for Windows users, web experiments, and things built on a Zo computer — all AI-assisted, all shipped."
>
  <script type="application/ld+json" set:html={jsonLd} is:inline />

  <section class="hero">
    <Image
      class="hero-bg"
      src={earthrise}
      alt="A crescent Earth rising over the gray surface of the Moon"
      widths={[820, 1400, 2000]}
      sizes="100vw"
      loading="eager"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="now rise" style="--i: 0">
        <span class="dot live" aria-hidden="true"></span>
        Currently building <a href="/projects/obscura/">Obscura</a>, a local-first AI media studio for Windows
      </p>
      <h1 class="rise" style="--i: 1">I make tools, games, and weird useful things.</h1>
      <p class="lede rise" style="--i: 2">
        Self-taught builder, shipping for <strong>Windows users</strong>. I use AI to
        think better and build stranger, then hand the boring parts to a machine.
      </p>
      <nav class="links rise" style="--i: 3" aria-label="Profiles">
        {links.map((l) => (
          <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>{l.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <section class="wrap">
    <SectionHeading title="Selected work" note="Desktop apps and tools, built to be used." />
    <div class="rows">
      {featured.map((p, i) => (
        <ProjectCard project={p} index={i} variant="row" />
      ))}
    </div>
  </section>

  <section class="wrap">
    <SectionHeading
      title="On the Zo computer"
      note="Built and hosted on a personal cloud server I actually own."
    />
    <div class="grid">
      {zoShelf.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>
    <p class="shelf-link">
      The machine itself lives at <a href="https://jeffkazzee.zo.space" rel="noopener">jeffkazzee.zo.space</a>.
    </p>
  </section>

  <section class="wrap">
    <SectionHeading title="Writing" note="Essays and field notes on AI-assisted building." />
    <div class="posts">
      {posts.map((post, i) => (
        <PostCard post={post} index={i} />
      ))}
    </div>
    <p class="more"><a href="/blog/">All posts →</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(36rem, 92vh, 54rem);
    display: flex;
    align-items: flex-end;
  }

  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 70%;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--bg) 0%,
      oklch(0% 0 0 / 0) 16%,
      oklch(0% 0 0 / 0) 52%,
      oklch(8% 0.01 255 / 0.55) 78%,
      oklch(8% 0.01 255 / 0.88) 100%
    );
  }

  .hero-inner {
    position: relative;
    width: 100%;
    display: grid;
    gap: calc(var(--space) * 3);
    padding-block: clamp(6rem, 16vh, 9rem) clamp(3rem, 9vh, 5rem);
  }

  .now {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .now .dot {
    margin-right: 0.35em;
  }

  h1 {
    font-size: clamp(2.8rem, 6.5vw, 4.75rem);
    max-width: 15ch;
    color: var(--ink);
    text-shadow: 0 1px 24px oklch(5% 0.01 255 / 0.6);
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.7;
    color: oklch(84% 0.01 95);
    max-width: 46ch;
  }

  .lede strong {
    color: var(--ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding-top: calc(var(--space) * 1);
  }

  .links a {
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }

  .rows {
    border-bottom: 1px solid var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: calc(var(--space) * 4);
  }

  .shelf-link {
    margin-top: calc(var(--space) * 4);
    font-size: 0.95rem;
    color: var(--ink-faint);
  }

  .posts {
    border-bottom: 1px solid var(--line);
  }

  .more {
    padding-top: calc(var(--space) * 4);
    font-weight: 500;
  }

  .more a {
    text-decoration: none;
  }
</style>
