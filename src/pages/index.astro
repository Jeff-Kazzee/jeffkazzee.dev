---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import earthrise from '../assets/earthrise.avif';
import { SITE } from '../data/agent-surface.mjs';
import { totalItems } from '../data/libraries.mjs';

const projects = await getCollection('projects');
type Project = (typeof projects)[number];

const byOrder = (a: Project, b: Project) => a.data.order - b.data.order;
const shelf = (name: string) =>
  projects.filter((p) => p.data.shelf === name && !p.data.archived).sort(byOrder);

const community = shelf('community');
const tools = shelf('tools');
const side = shelf('side');

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

/** This post makes the case for the guides better than any copy could. */
const paidPost = posts.find((p) => p.id === 'a-company-paid-me-for-guides-i-gave-away');

const links = [
  { href: 'https://github.com/Jeff-Kazzee', label: 'GitHub' },
  { href: 'https://x.com/jeffkazzee', label: 'X' },
  { href: 'https://jeffkazzee.substack.com', label: 'Substack' },
  { href: 'mailto:jeffkazzee@gmail.com', label: 'Email' },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jeff Kazzee',
  url: SITE,
  description:
    'Writes free guides for building real systems on a computer you own, and builds software with AI agents.',
  sameAs: [
    'https://github.com/Jeff-Kazzee',
    'https://x.com/jeffkazzee',
    'https://jeffkazzee.substack.com',
    'https://jeffkazzee.zo.space',
  ],
});
---

<BaseLayout
  title="Jeff Kazzee"
  description="1,450 free guides and recipes for building real systems on a computer you own, plus open tools and side projects from Jeff Kazzee."
>
  <script type="application/ld+json" set:html={jsonLd} is:inline />

  <section class="hero">
    <Image
      class="hero-bg"
      src={earthrise}
      alt="A crescent Earth rising over the gray surface of the Moon"
      widths={[820, 1400, 2000]}
      sizes="100vw"
      loading="eager"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="now rise" style="--i: 0">
        <span class="dot live" aria-hidden="true"></span>
        Building <a href="https://llmarcade.fun" rel="noopener">LLM Arcade</a>
      </p>
      <h1 class="rise" style="--i: 1">I give away the guides, and build the things I'm learning on.</h1>
      <p class="lede rise" style="--i: 2">
        <strong>{totalItems.toLocaleString('en-US')} free guides and recipes</strong> for building
        real systems on a computer you own, plus open tools and a few side projects. Self-taught,
        still learning in public.
      </p>
      <nav class="links rise" style="--i: 3" aria-label="Profiles">
        {links.map((l) => (
          <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>{l.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <section class="wrap">
    <SectionHeading
      title="Community resources"
      note="Free libraries for Zo Computer users. No email gate, no upsell."
    />
    <div class="grid">
      {community.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>
    {paidPost && (
      <p class="aside">
        Someone once paid me for guides I had already given away.
        <a href={`/blog/${paidPost.id}/`}>That story is here</a>.
      </p>
    )}
  </section>

  <section class="wrap">
    <SectionHeading title="Open tools" note="Built because I needed them, then given away." />
    <div class="grid">
      {tools.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>
  </section>

  <section class="wrap">
    <SectionHeading
      title="Side projects"
      note="Built for the fun of it. AI agents wrote every line of LLM Arcade."
    />
    <div class="grid">
      {side.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>
    <p class="more"><a href="/projects/">Everything else, including the archive →</a></p>
  </section>

  <section class="wrap">
    <div class="agent-note reveal">
      <div class="agent-text">
        <p class="eyebrow">
          <span class="dot live" aria-hidden="true"></span>
          For agents
        </p>
        <h2>This site answers to machines, not just browsers.</h2>
        <p class="say">
          Ask any page for <code>Accept: text/markdown</code> and it returns Markdown. There is an
          MCP server, an A2A agent card, WebMCP tools registered in the page, a published set of
          agent skills, and DNS records that point agents here before they fetch anything.
        </p>
      </div>
      <div class="agent-links">
        <ul role="list">
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/api/mcp">mcp</a></li>
          <li><a href="/.well-known/agent-card.json">a2a</a></li>
          <li><a href="/.well-known/agent-skills/index.json">skills</a></li>
        </ul>
        <a class="agent-more" href="/for-agents/">How it works &rarr;</a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <SectionHeading title="Writing" note="Essays and field notes on AI-assisted building." />
    <div class="posts">
      {posts.map((post, i) => (
        <PostCard post={post} index={i} />
      ))}
    </div>
    <p class="more"><a href="/blog/">All posts →</a></p>
  </section>

  <section class="wrap cta-band">
    <div class="cta-inner">
      <h2>Want to learn this, not just read about it?</h2>
      <p>
        I teach people to build with AI, live and screen-shared. Learn to code, use AI on your
        real job, or ship the thing you keep putting off. One-on-one or in a small group.
      </p>
      <a href="/work-with-me/" class="btn primary">Work with me</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(36rem, 92vh, 54rem);
    display: flex;
    align-items: flex-end;
  }

  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 70%;
  }

  /*
   * Two passes. The vertical one seals the header seam at the top and carries
   * the page colour back in at the bottom. The horizontal one keeps the text
   * column dark wherever the Earth happens to sit, because the headline runs
   * straight across its bright limb without it.
   */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        oklch(8% 0.01 255 / 0.9) 0%,
        oklch(8% 0.01 255 / 0.82) 32%,
        oklch(8% 0.01 255 / 0.5) 52%,
        oklch(8% 0.01 255 / 0.16) 70%,
        oklch(0% 0 0 / 0) 84%
      ),
      linear-gradient(
        to bottom,
        var(--bg) 0%,
        oklch(0% 0 0 / 0) 18%,
        oklch(0% 0 0 / 0) 55%,
        oklch(8% 0.01 255 / 0.5) 80%,
        oklch(8% 0.01 255 / 0.88) 100%
      );
  }

  .hero-inner {
    position: relative;
    width: 100%;
    display: grid;
    gap: calc(var(--space) * 3);
    padding-block: clamp(6rem, 16vh, 9rem) clamp(3rem, 9vh, 5rem);
  }

  .now {
    font-size: 0.92rem;
    color: var(--ink-soft);
    text-shadow: 0 1px 10px oklch(5% 0.01 255 / 0.7);
  }

  .now .dot {
    margin-right: 0.35em;
  }

  h1 {
    font-size: clamp(2.6rem, 5.6vw, 4.25rem);
    max-width: 14ch;
    color: var(--ink);
    /* A tight shadow plus a wide one: the first holds the letterforms against
       cloud, the second sinks the whole line into the sky. */
    text-shadow:
      0 1px 3px oklch(5% 0.01 255 / 0.75),
      0 2px 32px oklch(5% 0.01 255 / 0.7);
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.7;
    color: oklch(88% 0.008 95);
    max-width: 44ch;
    text-shadow: 0 1px 12px oklch(5% 0.01 255 / 0.6);
  }

  .lede strong {
    color: var(--ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    padding-top: calc(var(--space) * 1);
  }

  .links a {
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }

  .rows {
    border-bottom: 1px solid var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: calc(var(--space) * 4);
  }

  .aside {
    margin-top: calc(var(--space) * 4);
    font-size: 0.95rem;
    color: var(--ink-faint);
  }

  .aside a {
    margin-left: 0.35em;
  }

  .posts {
    border-bottom: 1px solid var(--line);
  }

  .more {
    padding-top: calc(var(--space) * 4);
    font-weight: 500;
  }

  .more a {
    text-decoration: none;
  }

  /* ---------- for agents ---------- */

  .agent-note {
    border-block: 1px solid var(--line);
    padding-block: clamp(2.25rem, 6vh, 3.25rem);
    margin-top: clamp(3rem, 8vh, 4.5rem);
    display: grid;
    gap: calc(var(--space) * 3.5);
    align-items: start;
  }

  @media (min-width: 860px) {
    .agent-note {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(2rem, 6vw, 4.5rem);
    }
  }

  .eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: calc(var(--space) * 2);
  }

  .agent-note h2 {
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    max-width: 22ch;
  }

  .say {
    margin-top: calc(var(--space) * 2);
    color: var(--ink-soft);
    max-width: 58ch;
    font-size: 0.98rem;
  }

  .agent-links {
    display: grid;
    gap: calc(var(--space) * 2.5);
    justify-items: start;
  }

  .agent-links ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .agent-links li a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--ink-soft);
    background: var(--bg-raised);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.28rem 0.75rem;
    transition: border-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }

  .agent-links li a:hover {
    color: var(--accent-bright);
    border-color: oklch(78% 0.11 155 / 0.4);
  }

  .agent-more {
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }

  .cta-band {
    padding-block: clamp(3.5rem, 9vh, 5.5rem);
  }

  .cta-inner {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    padding: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--space) * 2.5);
  }

  .cta-inner h2 {
    max-width: 18ch;
  }

  .cta-inner p {
    max-width: 44ch;
    color: var(--ink-soft);
  }
</style>
