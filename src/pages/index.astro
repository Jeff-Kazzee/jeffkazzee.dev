---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import cosmicCliffs from '../assets/cosmic-cliffs.jpg';
import Status from '../components/Status.astro';
import { SITE } from '../data/agent-surface.mjs';

type Project = CollectionEntry<'projects'>;

const projects = await getCollection('projects');
const bySlug = new Map(projects.map((p) => [p.id, p]));

/**
 * The home page picks its projects by slug. A feature or card links straight to
 * a live site, so it must have a screenshot and a `verified` stamp from
 * `npm run verify:projects`. Rows link to the project page on this site.
 */
const FEATURE = 'vivary';
const CARDS = ['open-world-factbook', 'llm-arcade', 'puckwork', 'neon-noir-detective-agency'];
const ROWS = ['context-engine', 'sdlc-skills', 'dumpling-cafe'];

function pick(slug: string, needsLive: boolean): Project {
  const project = bySlug.get(slug);
  if (!project) throw new Error(`Home page lists "${slug}", but there is no such project.`);
  if (needsLive) {
    if (!project.data.verified)
      throw new Error(`"${slug}" is on the home page but was never verified. Run npm run verify:projects.`);
    if (!project.data.screenshots.length)
      throw new Error(`"${slug}" is a home page card but has no screenshot.`);
  }
  return project;
}

const feature = pick(FEATURE, true);
const cards = CARDS.map((slug) => pick(slug, true));
const rows = ROWS.map((slug) => pick(slug, false));

const host = (url?: string) => (url ? new URL(url).host.replace(/^www\./, '') : undefined);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jeff Kazzee',
  url: SITE,
  description:
    'Self-taught developer building agent tools with AI-assisted workflows, and a Zo ambassador writing practical technical guides.',
  sameAs: [
    'https://github.com/Jeff-Kazzee',
    'https://x.com/jeffkazzee',
    'https://jeffkazzee.substack.com',
    'https://jeffkazzee.zo.space',
  ],
});
---

<BaseLayout
  title="Jeff Kazzee"
  description="Jeff Kazzee builds agent tools with AI-assisted workflows. Explore Vivary, experimental Context Engine tooling, and Zo technical guides. Open to developer roles."
  overlayHeader
>
  <script type="application/ld+json" set:html={jsonLd} is:inline />

  <section class="hero" aria-labelledby="hero-title">
    <Picture
      class="hero-bg"
      src={cosmicCliffs}
      alt="The Cosmic Cliffs of the Carina Nebula: a ridge of gold and rust gas under a field of stars, photographed by the James Webb Space Telescope"
      widths={[640, 828, 1080, 1280, 1440, 1680, 1920, 2560]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      quality={44}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <h1 id="hero-title">I build tools for working with AI.</h1>
      <p class="lede">
        I'm a self-taught developer working with AI coding agents. My current projects are
        <a href="/projects/vivary/">Vivary</a>, an agent workspace, and
        <a href="/projects/context-engine/">Context Engine</a>, experimental context tooling.
        I'm looking for developer roles.
      </p>
      <div class="actions">
        <a class="btn primary" href="#projects">See the work</a>
        <a class="btn" href="mailto:jeffkazzee@gmail.com">Email me</a>
      </div>
    </div>
    <div class="wrap credit-wrap">
      <p class="credit">Cosmic Cliffs, Carina Nebula. JWST, NASA, ESA, CSA, STScI</p>
    </div>
  </section>

  <section class="wrap section feature" aria-labelledby="feature-title">
    <a class="feature-shot" href="https://vivaryagent.xyz" tabindex="-1" aria-hidden="true">
      <span class="frame">
        <Image
          class="shot"
          src={feature.data.screenshots[0].src}
          alt=""
          widths={[400, 560, 720, 960, 1120]}
          sizes="(min-width: 1120px) 580px, (min-width: 860px) 55vw, calc(100vw - 2rem)"
        />
      </span>
    </a>
    <div class="feature-text">
      <p class="meta">
        <Status status={feature.data.status} />
        <span>{feature.data.stack.slice(0, 3).join(' · ')}</span>
      </p>
      <h2 id="feature-title"><a href={`/projects/${feature.id}/`}>{feature.data.title}</a></h2>
      <p class="desc">{feature.data.description}</p>
      <p class="links">
        <a href="https://vivaryagent.xyz">vivaryagent.xyz</a>
        <a href={`/projects/${feature.id}/`}>Project notes</a>
        {feature.data.repoUrl && <a href={feature.data.repoUrl}>GitHub</a>}
      </p>
    </div>
  </section>

  <section id="projects" class="wrap section" aria-labelledby="projects-title">
    <div class="section-head">
      <h2 id="projects-title">Projects</h2>
      <a class="see-all" href="/projects/">All projects</a>
    </div>

    <div class="cards">
      {cards.map((p, i) => (
        <a class="card reveal" style={`--i: ${i}`} href={p.data.liveUrl ?? `/projects/${p.id}/`}>
          <span class="frame">
            <Image
              class="shot"
              src={p.data.screenshots[0].src}
              alt={p.data.screenshots[0].alt}
              widths={[360, 480, 640, 800, 1040]}
              sizes="(min-width: 1120px) 504px, (min-width: 680px) calc(50vw - 3rem), calc(100vw - 2rem)"
            />
          </span>
          <span class="card-title">{p.data.title}</span>
          <span class="card-desc">{p.data.description}</span>
          <span class="meta">
            <Status status={p.data.status} />
            {host(p.data.liveUrl) && <span>{host(p.data.liveUrl)}</span>}
          </span>
        </a>
      ))}
    </div>

    <ul class="rows" role="list">
      {rows.map((p) => (
        <li>
          <a class="row" href={`/projects/${p.id}/`}>
            <span class="row-title">{p.data.title}</span>
            <span class="row-desc">{p.data.description}</span>
            <Status status={p.data.status} />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="writing-title">
    <div class="section-head">
      <h2 id="writing-title">Writing</h2>
      <a class="see-all" href="/blog/">All posts</a>
    </div>
    <ul class="posts" role="list">
      {posts.map((post) => (
        <li>
          <a class="post" href={`/blog/${post.id}/`}>
            <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
            <span class="post-body">
              <span class="post-title">{post.data.title}</span>
              <span class="post-desc">{post.data.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="agents-title">
    <div class="agent-note reveal">
      <div class="agent-text">
        <p class="eyebrow">For agents</p>
        <h2 id="agents-title">This site answers to machines, not just browsers.</h2>
        <p class="say">
          Ask any page for <code>Accept: text/markdown</code> and it returns Markdown. There is an
          MCP server, an A2A agent card, WebMCP tools registered in the page, a published set of
          agent skills, and DNS records that point agents here before they fetch anything.
        </p>
      </div>
      <div class="agent-links">
        <ul role="list">
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/api/mcp">mcp</a></li>
          <li><a href="/.well-known/agent-card.json">a2a</a></li>
          <li><a href="/.well-known/agent-skills/index.json">skills</a></li>
        </ul>
        <a class="agent-more" href="/for-agents/">How it works &rarr;</a>
      </div>
    </div>
  </section>

  <section class="wrap section contact" aria-labelledby="contact-title">
    <div class="contact-text">
      <h2 id="contact-title">Get in touch</h2>
      <p>
        I'm open to developer roles and conversations about agent tooling, practical workflows,
        and technical documentation. I also teach people to build with AI.
      </p>
    </div>
    <div class="actions">
      <a href="mailto:jeffkazzee@gmail.com" class="btn primary">Email me</a>
      <a href="/work-with-me/" class="btn">Work with me</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero ---------- */

  .hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(30rem, 72vh, 42rem);
    display: flex;
    align-items: flex-end;
    background: var(--bg);
  }

  .hero :global(.hero-bg),
  .hero :global(.hero-bg img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 45%;
  }

  /*
   * The text column sits on a dark left side and a dark bottom edge, so the
   * copy never runs across the bright ridge.
   */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(11 14 26 / 0.92) 0%,
        rgb(11 14 26 / 0.8) 34%,
        rgb(11 14 26 / 0.35) 62%,
        rgb(11 14 26 / 0) 82%
      ),
      linear-gradient(180deg, rgb(11 14 26 / 0.6) 0%, rgb(11 14 26 / 0) 22%, rgb(11 14 26 / 0) 70%, var(--bg) 100%);
  }

  @media (max-width: 720px) {
    .hero-scrim {
      background: linear-gradient(
        180deg,
        rgb(11 14 26 / 0.6) 0%,
        rgb(11 14 26 / 0.15) 22%,
        rgb(11 14 26 / 0.7) 48%,
        rgb(11 14 26 / 0.94) 72%,
        var(--bg) 100%
      );
    }
  }

  .hero-inner {
    position: relative;
    width: 100%;
    display: grid;
    gap: calc(var(--space) * 2.5);
    justify-items: start;
    padding-block: 7rem 4rem;
  }

  .hero-inner > * {
    max-width: 34rem;
  }

  h1 {
    font-size: clamp(2.1rem, 4vw, 3.1rem);
    line-height: 1.1;
    color: var(--ink);
  }

  .lede {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .lede a {
    color: var(--accent-bright);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: calc(var(--space) * 1);
  }

  /* Same right edge as every section below it. */
  .credit-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.75rem;
  }

  .credit {
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-align: right;
    max-width: none;
  }

  @media (max-width: 720px) {
    .hero-inner {
      padding-block: 6.5rem 3rem;
    }

    .credit-wrap {
      bottom: 0.5rem;
    }
  }

  /* ---------- shared ---------- */

  .section {
    padding-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: calc(var(--space) * 4);
  }

  .see-all {
    font-size: 0.95rem;
    text-decoration: none;
  }

  .see-all::after {
    content: ' →';
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .frame {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .frame :global(.shot) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: filter 0.3s var(--ease-out);
  }

  /* ---------- feature ---------- */

  .feature {
    display: grid;
    gap: calc(var(--space) * 4);
    align-items: center;
  }

  @media (min-width: 860px) {
    .feature {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .feature-shot {
    display: block;
  }

  /* Narrow screens: name and description before the picture. */
  @media (max-width: 859px) {
    .feature-text {
      order: -1;
    }
  }

  .feature-shot:hover :global(.shot) {
    filter: brightness(1.08);
  }

  .feature-text {
    display: grid;
    gap: calc(var(--space) * 1.5);
    justify-items: start;
  }

  .feature-text h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .feature-text h2 a:hover {
    color: var(--accent-bright);
  }

  .feature-text .desc {
    color: var(--ink-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  .links a {
    padding-block: 0.5rem;
  }

  /* ---------- project cards ---------- */

  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--space) * 5) calc(var(--space) * 4);
  }

  /* Four cards, so two columns: no card is ever left alone on a row. */
  @media (min-width: 680px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    display: grid;
    gap: calc(var(--space) * 1.25);
    align-content: start;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .card .frame {
    margin-bottom: calc(var(--space) * 0.75);
  }

  .card:hover :global(.shot) {
    filter: brightness(1.08);
  }

  .card-title {
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--ink);
    transition: color var(--t-fast) var(--ease-out);
  }

  .card:hover .card-title {
    color: var(--accent-bright);
  }

  .card-desc {
    font-size: 0.975rem;
    color: var(--ink-muted);
  }

  /* ---------- project rows ---------- */

  .rows {
    list-style: none;
    padding: 0;
    margin-top: calc(var(--space) * 6);
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr) auto;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .row-title {
    font-weight: 600;
    color: var(--ink);
    transition: color var(--t-fast) var(--ease-out);
  }

  .row:hover .row-title {
    color: var(--accent-bright);
  }

  .row-desc {
    font-size: 0.95rem;
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .row-desc {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  /* ---------- writing ---------- */

  .posts {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .post {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }

  .post-date {
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .post-body {
    display: grid;
    gap: 0.25rem;
  }

  .post-title {
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.35;
    color: var(--ink);
    transition: color var(--t-fast) var(--ease-out);
  }

  .post:hover .post-title {
    color: var(--accent-bright);
  }

  .post-desc {
    font-size: 0.95rem;
    color: var(--ink-muted);
    max-width: 62ch;
  }

  @media (max-width: 720px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- for agents (copy kept word for word from the live site) ---------- */

  .agent-note {
    display: grid;
    gap: calc(var(--space) * 4);
    align-items: start;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  @media (min-width: 860px) {
    .agent-note {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .eyebrow {
    font-size: 0.9rem;
    color: var(--ink-faint);
    margin-bottom: calc(var(--space) * 1);
  }

  .agent-note h2 {
    font-size: clamp(1.35rem, 2.2vw, 1.6rem);
    max-width: 24ch;
  }

  .say {
    margin-top: calc(var(--space) * 1.5);
    color: var(--ink-soft);
    font-size: 0.975rem;
  }

  .agent-links {
    display: grid;
    gap: calc(var(--space) * 2);
    justify-items: start;
    align-self: center;
  }

  .agent-links ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .agent-links li a {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.35rem 0.75rem;
  }

  .agent-links li a:hover {
    color: var(--accent-bright);
    border-color: var(--line-strong);
  }

  .agent-more {
    font-size: 0.95rem;
    text-decoration: none;
  }

  /* ---------- contact ---------- */

  /* Text left, buttons on the right edge of the column. */
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: calc(var(--space) * 3) calc(var(--space) * 6);
  }

  .contact-text {
    display: grid;
    gap: calc(var(--space) * 1.5);
    flex: 1 1 28rem;
  }

  .contact p {
    color: var(--ink-muted);
    max-width: 52ch;
  }
</style>
