---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · jeffkazzee.dev" description="This page doesn't exist.">
  <section class="wrap">
    <h1>404</h1>
    <p class="wink">No such file or directory. The machine and I both checked.</p>
    <p><a class="btn" href="/">Return home</a></p>
  </section>
</BaseLayout>

<style>
  section {
    padding-block: clamp(5rem, 18vh, 10rem);
    display: grid;
    gap: calc(var(--space) * 3);
    justify-items: start;
  }

  h1 {
    font-size: clamp(4.5rem, 16vw, 9rem);
    font-weight: 500;
    color: var(--accent);
    line-height: 1;
  }

  .wink {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
</style>
